# Handover AI — 環境変数のサンプル
#
# 未設定のままでもアプリは動作します（モックAIで申し送りを生成します）。
# 実AI APIへ接続する場合のみ、このファイルを .env.local にコピーして値を設定してください。
#
#   cp .env.example .env.local
#
# これらの値はサーバー側（app/api/handover/route.ts）でのみ読み取られます。
# NEXT_PUBLIC_ 接頭辞を付けるとブラウザへ露出するため、APIキーには絶対に使用しないでください。

# OpenAI互換APIのAPIキー
OPENAI_API_KEY=

# 使用モデル（未設定時は gpt-4o-mini）
OPENAI_MODEL=

# APIのベースURL（OpenAI以外の互換APIを使う場合のみ。未設定時は https://api.openai.com/v1）
OPENAI_BASE_URL=
